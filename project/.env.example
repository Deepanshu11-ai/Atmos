# Database
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# SMTP email delivery. Use an SMTP app password, not a regular mailbox password.
# Port 587: SMTP_USE_TLS=true and SMTP_USE_SSL=false (recommended).
# Port 465: SMTP_USE_TLS=false and SMTP_USE_SSL=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM="Atmos <no-reply@example.com>"
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Google Drive Picker. These are browser-facing Google Cloud identifiers, not
# a client secret. Enable both Google Drive API and Google Picker API, and add
# the frontend URL (for example http://127.0.0.1:5173) as an authorized
# JavaScript origin for the OAuth web client.
GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_API_KEY=your-browser-api-key
GOOGLE_DRIVE_APP_ID=your-google-cloud-project-number

# The in-app help assistant is local, role-aware workflow guidance. It does
# not need an LLM key and never receives bills, financial records, or secrets.
